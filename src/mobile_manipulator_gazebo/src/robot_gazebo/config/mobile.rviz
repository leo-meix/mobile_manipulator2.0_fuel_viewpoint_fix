Panels:
  - Class: rviz/Displays
    Help Height: 104
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /occupied_all1/Autocompute Value Bounds1
      Splitter Ratio: 0.5
    Tree Height: 889
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded:
      - /2D Pose Estimate1
      - /2D Nav Goal1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Name: Time
    SyncMode: 0
    SyncSource: depth
