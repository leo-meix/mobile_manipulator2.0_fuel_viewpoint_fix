<?xml version="1.0" ?>
<robot name="wheel" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="wheel_link" params="name side">
    <link name="${name}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://agv_description/mesh/visual/wheel.dae" scale="1.05 1.05 1.05" />
        </geometry>
      </visual>
      <!-- Disable wheel-ground collision dynamics: wheel is visual + inertia only. -->
      <inertial>
        <origin xyz="0 0 0" />
        <mass value="2.0" />
        <inertia ixx="0.042025" ixy="0.0" ixz="0.0"
                 iyy="0.024279" iyz="0.0"
                 izz="0.024279" />
      </inertial>
    </link>

    <gazebo reference="${name}_wheel_link">
      <gravity>false</gravity>
      <selfCollide>false</selfCollide>
    </gazebo>

  </xacro:macro>

</robot>
